# Public Firebase Web App configuration, NOT service-account credentials.
# Copy to .env.local for cloud testing. VITE_* values are public in browser bundles.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false

# Server-only AI configuration. NEVER use a VITE_ prefix for these secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Shared REST Redis store required on Vercel (Upstash/Vercel Marketplace).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional local-only cache/rate limiter. Ignored on Vercel.
AI_USE_LOCAL_STORE=true
